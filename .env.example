ASSEMBLYAI_API_KEY=your_api_key_here
ADMIN_PASSWORD=choose_a_strong_password

# Catalog selection; umbrella is the default demo.
ACTIVE_CATALOG=umbrella
COMPARISON_CONFIDENCE_CUTOFF=0.30

# Catalog onboarding uses the AssemblyAI LLM Gateway with ASSEMBLYAI_API_KEY above.
# CATALOG_LLM_MODEL names a gateway model; qwen3.5-4b-32k-fast is used when it is empty.
CATALOG_LLM_MODEL=qwen3.5-4b-32k-fast
# Or set CATALOG_LLM_COMMAND and use --provider command for a local adapter.
